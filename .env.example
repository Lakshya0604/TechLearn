# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/techlearn

# JWT signing secret (any long random string)
SECRET_KEY=change-me

# Cloudinary credentials (console.cloudinary.com -> Settings -> API Keys)
CLOUD_NAME=
API_KEY=
API_SECRET=

# Stripe TEST keys only for this demo deployment (dashboard.stripe.com -> Developers)
STRIPE_SECRET_KEY=sk_test_...
WEBHOOK_ENDPOINT_SECRET=whsec_...

# Public URL of the app (no trailing slash); used for Stripe redirect URLs and CORS
FRONTEND_URL=http://localhost:5173

# Optional: when set, instructor self-signup requires this code
INSTRUCTOR_INVITE_CODE=

PORT=5000
NODE_ENV=development
